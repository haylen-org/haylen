<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard" version="3.0" toolsVersion="23504" targetRuntime="AppleTV" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="root">
                        <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="splash_logo" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                                <rect key="frame" x="780" y="360" width="360" height="360"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe"/>
                        <color key="backgroundColor" name="splash_background"/>
                        <constraints>
                            <constraint firstItem="logo" firstAttribute="centerX" secondItem="safe" secondAttribute="centerX" id="centerX"/>
                            <constraint firstItem="logo" firstAttribute="centerY" secondItem="safe" secondAttribute="centerY" id="centerY"/>
                            <constraint firstItem="logo" firstAttribute="height" secondItem="logo" secondAttribute="width" id="square"/>
                            <constraint firstItem="logo" firstAttribute="width" relation="lessThanOrEqual" constant="360" id="maximum"/>
                            <constraint firstItem="logo" firstAttribute="width" relation="lessThanOrEqual" secondItem="safe" secondAttribute="width" multiplier="0.5" id="fitWidth"/>
                            <constraint firstItem="logo" firstAttribute="height" relation="lessThanOrEqual" secondItem="safe" secondAttribute="height" multiplier="0.5" id="fitHeight"/>
                            <constraint firstItem="logo" firstAttribute="width" constant="360" priority="750" id="preferred"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="splash_logo" width="512" height="512"/>
        <namedColor name="splash_background">
            <color red="0.063" green="0.078" blue="0.094" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
