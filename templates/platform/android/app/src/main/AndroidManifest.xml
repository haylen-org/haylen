<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phones, tablets and TVs run the app, so it needs neither a touchscreen nor a screen orientation, and it takes gamepads and TV remotes. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name="${haylenApplication}"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="${haylenAppName}"
        android:theme="@style/Theme.Haylen.Splash">
        <!-- Single top keeps one activity, which GameActivity needs, without destroying the screens of plugins that show over the app, such as a purchase, when the launcher icon brings the app back. Links and notifications go through `dev.haylen.HaylenLinkActivity` of the `haylen` library. -->
        <activity
            android:name="dev.haylen.HaylenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="${haylenScreenOrientation}">
            <meta-data
                android:name="android.app.lib_name"
                android:value="${haylenLibrary}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
