<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access, the network events and vibration of the engine need these permissions. An app that does not use a feature deletes its permission, and the feature then logs once what is missing and does nothing or fails its calls with the code `unsupported`. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phones, tablets and TVs run the app, so it needs neither a touchscreen nor a screen orientation, and it takes gamepads and TV remotes. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Back reaches `HaylenActivity` through its `OnBackPressedCallback`, which Android 13 and later call through the back callbacks of the window that `enableOnBackInvokedCallback` turns on, so the system plays its predictive back animation when back leaves the app. -->
    <application
        android:name="${haylenApplication}"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${haylenAppName}"
        android:theme="@style/Theme.Haylen.Splash">
        <!-- Single top keeps one activity, which GameActivity needs, without destroying the screens of plugins that show over the app, such as a purchase, when the launcher icon brings the app back. Links and notifications go through `dev.haylen.HaylenLinkActivity`, which the `haylen-links` library of the plugins that receive them declares. -->
        <activity
            android:name="dev.haylen.HaylenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="${haylenScreenOrientation}">
            <meta-data
                android:name="android.app.lib_name"
                android:value="${haylenLibrary}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
