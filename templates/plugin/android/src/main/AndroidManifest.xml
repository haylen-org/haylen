<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The haylen library creates and loads the plugin class that this entry names when the app process starts. -->
        <meta-data
            android:name="dev.haylen.plugin.{{ID}}"
            android:value="dev.haylen.plugins.{{PACKAGE}}.{{NAME}}Plugin" />
    </application>
</manifest>
