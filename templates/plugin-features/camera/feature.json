{
    "choice": true,
    "description": "The camera into a video stream and photos as JPEG bytes, after the person allowed the camera.",
    "parts": [
        "permissions",
        "desktop-unsupported"
    ],
    "blocks": {
        "APPLE_MEMBERS": [
            "private let camera = {{NAME}}Camera()"
        ],
        "APPLE_LOAD": [
            "camera.register(context)"
        ],
        "ANDROID_MEMBERS": [
            "private lateinit var camera: {{NAME}}Camera"
        ],
        "ANDROID_LOAD": [
            "camera = {{NAME}}Camera(context, permissions)",
            "camera.register()"
        ],
        "ANDROID_MANIFEST": [
            "<!-- The camera that \"startCamera\" asks the person for, which devices without a camera, such as TVs, lack while they still install the app. -->",
            "<uses-permission android:name=\"android.permission.CAMERA\" />",
            "<uses-feature android:name=\"android.hardware.camera\" android:required=\"false\" />"
        ],
        "WEB_IMPORTS": [
            "import registerCamera from \"./camera.js\";"
        ],
        "WEB_LOAD": [
            "registerCamera(context);"
        ],
        "NATIVE_REGISTER": [
            "api->registerHandler(\"{{ID}}.startCamera\", {{SYMBOL}}_unsupported, NULL, NULL);",
            "api->registerHandler(\"{{ID}}.stopCamera\", {{SYMBOL}}_unsupported, NULL, NULL);",
            "api->registerHandler(\"{{ID}}.takePhoto\", {{SYMBOL}}_unsupported, NULL, NULL);"
        ],
        "README_NATIVE": [
            "| `{{ID}}.startCamera` | `{facing}` | `{width, height, facing}` |",
            "| `{{ID}}.stopCamera` | `{}` | |",
            "| `{{ID}}.takePhoto` | `{}` | `{jpeg, width, height}`, with the bytes of a JPEG file in `jpeg` |"
        ]
    },
    "plugin": {
        "parameters": {
            "cameraUsage": {
                "type": "string",
                "platforms": [
                    "ios",
                    "catalyst",
                    "macos"
                ],
                "default": "The app shows the camera.",
                "description": "Text of the camera permission prompt on Apple platforms."
            },
            "macDevices": {
                "type": "boolean",
                "platforms": [
                    "macos"
                ],
                "default": true,
                "description": "Whether the macOS app signs with the entitlements of the hardened runtime that the camera, the microphone and the location of the plugin need. The parameter has a value on macOS alone, so the other platforms leave the entitlements out."
            }
        },
        "apple": {
            "frameworks": [
                "AVFoundation.framework"
            ],
            "infoPlist": {
                "NSCameraUsageDescription": "${cameraUsage}"
            },
            "entitlements": {
                "com.apple.security.device.camera": "${macDevices}"
            }
        }
    }
}
