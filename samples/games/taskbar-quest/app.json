{
    "name": "Haylen Taskbar Quest",
    "identifier": "dev.haylen.samples.taskbarquest",
    "version": "1.0.0",
    "orientation": "landscape",
    "window": {
        "title": "Taskbar Quest",
        "width": 1280,
        "height": 200,
        "resizable": false,
