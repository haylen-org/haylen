{
    "name": "Music Streaming",
    "identifier": "com.haylen.music",
    "version": "1.0.0",
    "category": "music",
    "orientation": "any",
    "window": {
        "title": "Music Streaming",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "maxPixelDensity": 0,
        "redraw": "onChange",
        "statusBar": "light"
    },
    "design": {
        "width": 1280,
        "height": 820,
        "scaling": "none"
    },
    "ui": {
        "scaleMode": "physical"
    },
    "audio": {
        "iosSession": "playback"
    },
    "splash": {
        "background": "#FF0B0A12"
    },
    "clearColor": "#FF0B0A12",
    "lua": {
        "autoloads": ["player"]
    },
    "plugins": {
        "music-links": {}
    }
}
