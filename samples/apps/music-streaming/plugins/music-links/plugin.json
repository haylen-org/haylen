{
    "interface": 1,
    "id": "music-links",
    "name": "Music Links",
    "version": "1.0.0",
    "description": "Registers the URL scheme haylenmusic, so links such as haylenmusic://artist/12 open the app and reach its routes.",
    "implementations": {"ios": "native", "catalyst": "native", "tvos": "native", "visionos": "native", "macos": "native", "android": "native", "web": "lua", "windows": "native", "linux": "native"},
    "contributions": [
        {
            "type": "infoPlist",
            "platforms": ["ios", "catalyst", "tvos", "visionos", "macos"],
            "values": {"CFBundleURLTypes": [{"CFBundleURLName": "com.haylen.plugins.music-links", "CFBundleURLSchemes": ["haylenmusic"]}]}
        },
        {"type": "gradleModule", "platforms": ["android"], "path": "android"},
        {"type": "urlScheme", "platforms": ["windows", "linux"], "scheme": "haylenmusic"}
    ]
}
