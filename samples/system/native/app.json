{
    "name": "Haylen Native",
    "identifier": "dev.haylen.samples.native",
    "version": "1.0.0",
    "orientation": "landscape",
    "window": {
        "title": "Haylen Native",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "highDpi": true
    },
    "design": {
        "width": 1920,
        "height": 1080,
        "scaling": "expand"
    },
    "clearColor": "#FF101418",
    "native": {
        "native_test": {
            "cmake": "native",
            "platforms": [
                "macos",
                "ios",
                "tvos",
                "android",
                "windows",
                "linux"
            ]
        },
        "native_test_static": {
            "cmake": "native",
            "platforms": [
                "ios",
                "tvos"
            ],
            "link": "static",
            "symbols": [
                "native_test_add",
                "native_test_scale",
                "native_test_origin",
                "native_test_checksum"
            ]
        }
    },
    "plugins": {
        "native-sample": {},
        "native-test": {}
    }
}
