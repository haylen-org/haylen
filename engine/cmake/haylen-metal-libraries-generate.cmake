# Writes `OUTPUT` as the C++ source of `haylen::gpu::metal::PrecompiledLibraries::getLibraries`. For each variant of `VARIANTS`, which reads `condition,sdk,target,language`, the Metal toolchain of Xcode compiles every source that the programs of the shader packages of `PACKAGES` name in the language of the variant into a library in `WORK`, and the source holds the libraries sorted by the SHA-256 of their source. Both lists separate their items with `|`.

string(REPLACE "|" ";" packages "${PACKAGES}")
string(REPLACE "|" ";" variants "${VARIANTS}")

set(body "")
foreach(variant IN LISTS variants)
  string(REPLACE "," ";" fields "${variant}")
  list(GET fields 0 condition)
  list(GET fields 1 sdk)
  list(GET fields 2 target)
  list(GET fields 3 language)
  set(folder "${WORK}/${target}")
  file(MAKE_DIRECTORY "${folder}")

  # A source that several programs share compiles once.
  set(keys "")
  foreach(package IN LISTS packages)
    file(READ "${package}" document)
    string(JSON programs GET "${document}" programs)
    string(JSON count LENGTH "${programs}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON program MEMBER "${programs}" ${index})
      string(JSON code ERROR_VARIABLE missing GET "${programs}" "${program}" targets ${language})
      if(missing)
        message(FATAL_ERROR "The program \"${program}\" of \"${package}\" has no code for \"${language}\".")
      endif()
      foreach(stage IN ITEMS vertex fragment)
        string(JSON source GET "${code}" ${stage} source)
        string(JSON text GET "${document}" sources ${source})
        string(SHA256 key "${text}")
        if(key IN_LIST keys)
          continue()
        endif()
        list(APPEND keys ${key})

        file(WRITE "${folder}/${key}.metal" "${text}")
        execute_process(COMMAND xcrun -sdk ${sdk} metal -target ${target} "${folder}/${key}.metal" -o "${folder}/${key}.metallib" RESULT_VARIABLE result ERROR_VARIABLE errors)
        if(NOT result EQUAL 0)
          message(FATAL_ERROR "The Metal toolchain could not compile the ${stage} stage of the program \"${program}\" of \"${package}\" for \"${target}\".\n${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()

  list(SORT keys)
  set(arrays "")
  set(entries "")
  set(number 0)
  foreach(key IN LISTS keys)
    file(READ "${folder}/${key}.metallib" library HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," library "${library}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){16}" "\\0\n        " library "${library}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," key "${key}")
    string(APPEND arrays "    static constexpr std::uint8_t kCode${number}[] = {\n        ${library}\n    };\n")
    string(APPEND entries "        {.key = {${key}}, .code = kCode${number}},\n")
    math(EXPR number "${number} + 1")
  endforeach()

  set(block "${arrays}    static constexpr std::array<Library, ${number}> kLibraries{{\n${entries}    }};\n    return kLibraries;\n")
  if(condition STREQUAL "none")
    string(APPEND body "${block}")
  else()
    string(APPEND body "#if ${condition}\n${block}#endif\n")
  endif()
endforeach()

file(WRITE "${OUTPUT}" "#include \"gpu/metal/PrecompiledLibraries.hpp\"\n\n#include <TargetConditionals.h>\n\n#include <array>\n#include <cstdint>\n\nnamespace haylen::gpu::metal {\n\nstd::span<const PrecompiledLibraries::Library> PrecompiledLibraries::getLibraries() {\n${body}}\n\n}\n")
