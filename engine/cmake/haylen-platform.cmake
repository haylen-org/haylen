if(APPLE)
  enable_language(OBJC OBJCXX)
endif()

# Mac Catalyst builds through `haylen-catalyst.toolchain.cmake` compile for the `macabi` flavor of iOS, so the engine treats them as iOS.
if(CMAKE_CXX_COMPILER_TARGET MATCHES "-macabi$")
  set(HAYLEN_CATALYST ON)
else()
  set(HAYLEN_CATALYST OFF)
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "iOS" OR HAYLEN_CATALYST)
  set(HAYLEN_PLATFORM "ios")
elseif(CMAKE_SYSTEM_NAME STREQUAL "tvOS")
  set(HAYLEN_PLATFORM "tvos")
elseif(ANDROID)
  set(HAYLEN_PLATFORM "android")
elseif(EMSCRIPTEN)
  set(HAYLEN_PLATFORM "web")
elseif(WIN32)
  set(HAYLEN_PLATFORM "windows")
elseif(APPLE)
  set(HAYLEN_PLATFORM "macos")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(HAYLEN_PLATFORM "linux")
else()
  message(FATAL_ERROR "The platform \"${CMAKE_SYSTEM_NAME}\" is not supported.")
endif()

if(HAYLEN_PLATFORM MATCHES "^(macos|windows|linux)$")
  set(HAYLEN_DESKTOP ON)
else()
  set(HAYLEN_DESKTOP OFF)
endif()

# The function `haylen_add_app` runs in the folders of the apps, which do not see the variables of the engine folder.
set(HAYLEN_PLATFORM "${HAYLEN_PLATFORM}" CACHE INTERNAL "Platform the engine is built for.")
set(HAYLEN_DESKTOP "${HAYLEN_DESKTOP}" CACHE INTERNAL "Whether the platform is a desktop.")

# Lua is compiled as C++ by Varn, so a Lua error unwinds as a C++ exception and a yield jumps back to its resume with `_longjmp`, and the browser build uses the native exceptions and the native `longjmp` of WebAssembly that Varn builds with.
if(EMSCRIPTEN)
  add_compile_options(-fwasm-exceptions "SHELL:-s SUPPORT_LONGJMP=wasm")
  add_link_options(-fwasm-exceptions "SHELL:-s SUPPORT_LONGJMP=wasm")
endif()

if(NOT EXISTS "${HAYLEN_BACKEND_DIR}/backend.cmake")
  message(FATAL_ERROR "The folder \"${HAYLEN_BACKEND_DIR}\" of \"HAYLEN_BACKEND_DIR\" holds no \"backend.cmake\". Name the folder of a backend, such as \"src/backends/sokol\" of the engine.")
endif()
# The backend is named after its folder, such as `sokol`, which the SDK records.
get_filename_component(HAYLEN_BACKEND "${HAYLEN_BACKEND_DIR}" NAME)

set(HAYLEN_GRAPHICS "${HAYLEN_GRAPHICS_API}")
if(HAYLEN_GRAPHICS STREQUAL "AUTO")
  if(APPLE)
    set(HAYLEN_GRAPHICS "METAL")
  elseif(WIN32)
    set(HAYLEN_GRAPHICS "D3D11")
  elseif(ANDROID)
    set(HAYLEN_GRAPHICS "GLES3")
  elseif(EMSCRIPTEN)
    set(HAYLEN_GRAPHICS "WGPU")
  else()
    set(HAYLEN_GRAPHICS "GLCORE")
  endif()
endif()

if(NOT HAYLEN_GRAPHICS MATCHES "^(METAL|D3D11|GLCORE|GLES3|WGPU)$")
  message(FATAL_ERROR "The graphics API \"${HAYLEN_GRAPHICS}\" is not supported.")
endif()

# The shader languages of the graphics API, which the shader packages of the engine carry. Apple builds carry the three kinds of Metal, since one slice of iOS runs on devices and Mac Catalyst and another on the simulator.
if(HAYLEN_GRAPHICS STREQUAL "METAL")
  set(HAYLEN_SHADER_LANGUAGES msl-macos msl-ios msl-ios-simulator)
elseif(HAYLEN_GRAPHICS STREQUAL "D3D11")
  set(HAYLEN_SHADER_LANGUAGES hlsl5)
elseif(HAYLEN_GRAPHICS STREQUAL "GLCORE")
  set(HAYLEN_SHADER_LANGUAGES glsl430)
elseif(HAYLEN_GRAPHICS STREQUAL "GLES3")
  set(HAYLEN_SHADER_LANGUAGES glsl300es)
else()
  set(HAYLEN_SHADER_LANGUAGES wgsl)
endif()

message(STATUS "Haylen platform: \"${HAYLEN_PLATFORM}\"")
message(STATUS "Haylen backend: \"${HAYLEN_BACKEND}\" drawing through \"${HAYLEN_GRAPHICS}\"")
