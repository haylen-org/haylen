+
+void ImGuiIO::AddKeyRepeatEvent(ImGuiKey key)
+{
+    IM_ASSERT(Ctx != NULL);
+    if (key == ImGuiKey_None || !AppAcceptingEvents)
+        return;
+    ImGuiContext& g = *Ctx;
+    IM_ASSERT(ImGui::IsKeyboardKey(key)); // Only keyboard keys repeat through the backend.
+
+    ImGuiInputEvent e;
+    e.Type = ImGuiInputEventType_Key;
+    e.Source = ImGuiInputSource_Keyboard;
+    e.EventId = g.InputEventsNextEventId++;
+    e.Key.Key = key;
+    e.Key.Down = true;
+    e.Key.Repeat = true;
+    e.Key.AnalogValue = 1.0f;
     g.InputEventsQueue.push_back(e);
 }
 
