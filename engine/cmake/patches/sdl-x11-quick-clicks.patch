Drops the copy of a press or a release of a slave pointer that its master reports, which the X server may deliver after both events of a quick click from the slave, so a click that a tap, an assistive tool or a remote desktop makes reaches the app once.

--- a/src/video/x11/SDL_x11xinput2.c
+++ b/src/video/x11/SDL_x11xinput2.c
@@ -59,6 +59,15 @@
 static unsigned char *xinput2_pointer_button_map;
 static int xinput2_pointer_button_map_size;
 
+// The last press and the last release of a slave pointer that reached the app, which the same event of its master repeats.
+typedef struct
+{
+    int device;
+    Time time;
+    int button;
+} SDL_XInput2SlaveButton;
+static SDL_XInput2SlaveButton xinput2_slave_buttons[2];
+
 #ifdef SDL_VIDEO_DRIVER_X11_XINPUT2_SUPPORTS_SCROLLINFO
 typedef struct
 {
@@ -701,6 +710,20 @@
                 break;
             }
 
+            /* The slave and its master report each press and release, and the X server may deliver both events of a quick click
+             * from the slave before those of the master, so the state of the buttons cannot tell the copies apart. The event of
+             * the master that repeats the press or the release of the slave that reached the app names the same slave as its
+             * source and carries the same time, while its serial may differ.
+             */
+            SDL_XInput2SlaveButton *slave_button = &xinput2_slave_buttons[down ? 1 : 0];
+            if (xev->deviceid == xev->sourceid) {
+                slave_button->device = xev->sourceid;
+                slave_button->time = xev->time;
+                slave_button->button = button;
+            } else if (slave_button->device == xev->sourceid && slave_button->time == xev->time && slave_button->button == button) {
+                break;
+            }
+
             if (down) {
                 X11_HandleButtonPress(_this, windowdata, (SDL_MouseID)xev->sourceid, button,
                                       (float)xev->event_x, (float)xev->event_y, xev->time, xev->serial);
