+_SOKOL_PRIVATE bool _sapp_android_on_key(GameActivity* activity, const GameActivityKeyEvent* event) {
+    _SOKOL_UNUSED(activity);
+    const int32_t code = event->keyCode;
+    if ((code < 0) || (code >= SAPP_MAX_KEYCODES)) {
+        return false;
+    }
+    bool taken = false;
+    if ((event->action == AKEY_EVENT_ACTION_DOWN) && (event->repeatCount == 0)) {
+        taken = _sapp_android_key_taken(event);
+        _sapp.android.keys_taken[code] = taken;
+    } else if (event->action == AKEY_EVENT_ACTION_DOWN) {
+        taken = _sapp.android.keys_taken[code];
+    } else if (event->action == AKEY_EVENT_ACTION_UP) {
+        taken = _sapp.android.keys_taken[code];
+        _sapp.android.keys_taken[code] = false;
+    }
+    if (taken) {
+        _sapp_android_input_t input;
+        input.type = _SAPP_ANDROID_INPUT_KEY;
+        input.key = *event;
+        _sapp_android_push_input(&input);
+    }
+    return taken;
