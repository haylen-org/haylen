+static uint64_t _sg_mtl_gpu_frame_ns;
+
 _SOKOL_PRIVATE void _sg_mtl_commit(void) {
     SOKOL_ASSERT(nil == _sg.mtl.render_cmd_encoder);
     SOKOL_ASSERT(nil == _sg.mtl.compute_cmd_encoder);
 
     // commit the frame's command buffer
     if (_sg.mtl.cmd_buffer) {
+        [_sg.mtl.cmd_buffer addCompletedHandler:^(id<MTLCommandBuffer> cmd_buf) {
+            const CFTimeInterval gpu_time = cmd_buf.GPUEndTime - cmd_buf.GPUStartTime;
+            if (gpu_time > 0.0) {
+                __atomic_store_n(&_sg_mtl_gpu_frame_ns, (uint64_t)(gpu_time * 1.0e9), __ATOMIC_RELAXED);
+            }
+        }];
         [_sg.mtl.cmd_buffer commit];
     }
 
