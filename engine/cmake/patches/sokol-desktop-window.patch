+// shows the swapchain in the window through a DirectComposition target with the swapchain as its only visual
+_SOKOL_PRIVATE void _sapp_d3d11_create_composition_visual(void) {
+    _sapp.d3d11.dcomp_dll = LoadLibraryA("dcomp.dll");
+    _sapp_dcomp_create_device_t create_device = 0;
+    if (_sapp.d3d11.dcomp_dll) {
+        create_device = (_sapp_dcomp_create_device_t)(void*) GetProcAddress(_sapp.d3d11.dcomp_dll, "DCompositionCreateDevice");
+    }
+    if (!create_device) {
+        _SAPP_PANIC(WIN32_LOAD_DCOMP_DLL_FAILED);
+    }
+    HRESULT hr = create_device((IDXGIDevice*)_sapp.d3d11.dxgi_device, _sapp_win32_refiid(_sapp_IID_IDCompositionDevice), (void**)&_sapp.d3d11.dcomp_device);
+    if (!SUCCEEDED(hr) || !_sapp.d3d11.dcomp_device) {
+        _SAPP_PANIC(WIN32_DCOMP_CREATE_DEVICE_FAILED);
     }
+    _sapp_dcomp_device_t* device = _sapp.d3d11.dcomp_device;
+    hr = device->lpVtbl->CreateTargetForHwnd(device, _sapp.win32.hwnd, TRUE, &_sapp.d3d11.dcomp_target);
+    if (SUCCEEDED(hr)) {
+        hr = device->lpVtbl->CreateVisual(device, &_sapp.d3d11.dcomp_visual);
+    }
+    if (SUCCEEDED(hr)) {
+        hr = _sapp.d3d11.dcomp_visual->lpVtbl->SetContent(_sapp.d3d11.dcomp_visual, (IUnknown*)_sapp.d3d11.swap_chain);
