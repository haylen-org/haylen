+// sets the desktop options of the window before it is mapped, which window managers read when they map it
+_SOKOL_PRIVATE void _sapp_x11_init_desktop_options(void) {
+    const sapp_desktop_desc* desktop = &_sapp.desc.desktop;
+    if (desktop->borderless) {
+        // the motif hints are the de-facto standard to ask window managers for a window without decorations
+        const Atom motif_wm_hints = XInternAtom(_sapp.x11.display, "_MOTIF_WM_HINTS", False);
+        const unsigned long hints[5] = { 2 /* MWM_HINTS_DECORATIONS */, 0, 0, 0, 0 };
+        XChangeProperty(_sapp.x11.display, _sapp.x11.window, motif_wm_hints, motif_wm_hints, 32, PropModeReplace, (const unsigned char*) hints, 5);
+    }
+    Atom states[3];
+    int num_states = 0;
+    if (desktop->topmost) {
+        states[num_states++] = XInternAtom(_sapp.x11.display, "_NET_WM_STATE_ABOVE", False);
+    }
+    if (desktop->skip_taskbar) {
+        states[num_states++] = XInternAtom(_sapp.x11.display, "_NET_WM_STATE_SKIP_TASKBAR", False);
+        states[num_states++] = XInternAtom(_sapp.x11.display, "_NET_WM_STATE_SKIP_PAGER", False);
+    }
+    if (num_states > 0) {
+        XChangeProperty(_sapp.x11.display, _sapp.x11.window, _sapp.x11.NET_WM_STATE, XA_ATOM, 32, PropModeReplace, (const unsigned char*) states, num_states);
+    }
+    _sapp_x11_set_focusable(_sapp.focusable);
+}
