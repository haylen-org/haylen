+    if (SUCCEEDED(hr)) {
+        hr = _sapp.d3d11.dcomp_target->lpVtbl->SetRoot(_sapp.d3d11.dcomp_target, _sapp.d3d11.dcomp_visual);
+    }
+    if (SUCCEEDED(hr)) {
+        hr = device->lpVtbl->Commit(device);
