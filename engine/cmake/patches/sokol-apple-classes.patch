Lets the app name the Objective-C classes of the application delegate and of the view controller that sokol_app creates, through sapp_desc.apple.delegate_class and sapp_desc.apple.view_controller_class. UIApplicationMain creates the delegate on iOS and tvOS, and the scene configuration names the class of the application delegate for the scenes, so one subclass receives every event of the application and its scenes. AppKit creates it on macOS. The subclass calls sokol_app for the events that sokol_app handles and hands every event to native plugins. The view controller that holds the Metal view on iOS and tvOS answers UIKit for the status bar of the app.

--- a/sokol_app.h
+++ b/sokol_app.h
@@ -2126,6 +2126,11 @@
     bool (*native_event_cb)(const void* native_event);
 } sapp_android_desc;
 
+typedef struct sapp_apple_desc {
+    const char* delegate_class; // name of a subclass of the sokol_app application delegate that UIKit or AppKit creates instead, which also delegates the scenes on iOS
+    const char* view_controller_class; // name of a subclass of UIViewController that holds the Metal view on iOS and tvOS instead of a plain UIViewController
+} sapp_apple_desc;
+
 typedef struct sapp_desktop_desc {
     bool borderless;            // if true, the window has no title bar and no border
     bool topmost;               // if true, the window floats above normal windows
@@ -2177,6 +2182,7 @@
     sapp_html5_desc html5;
     sapp_ios_desc ios;
     sapp_android_desc android;
+    sapp_apple_desc apple;
     sapp_desktop_desc desktop;          // window options of desktop platforms, see DESKTOP WINDOW OPTIONS
 } sapp_desc;
 
@@ -5971,7 +5977,8 @@
     // set the application dock icon as early as possible, otherwise
     // the dummy icon will be visible for a short time
     sapp_set_icon(&_sapp.desc.icon);
-    _sapp.macos.app_dlg = [[_sapp_macos_app_delegate alloc] init];
+    Class app_dlg_class = _sapp.desc.apple.delegate_class ? NSClassFromString(@(_sapp.desc.apple.delegate_class)) : [_sapp_macos_app_delegate class];
+    _sapp.macos.app_dlg = [[app_dlg_class alloc] init];
     NSApp.delegate = _sapp.macos.app_dlg;
 
     // workaround for "no key-up sent while Cmd is pressed" taken from GLFW:
@@ -6952,7 +6959,8 @@
 
     [_sapp.ios.view.layer addSublayer:_sapp.mtl.layer];
 
-    _sapp.ios.view_ctrl = [[UIViewController alloc] init];
+    Class view_ctrl_class = _sapp.desc.apple.view_controller_class ? NSClassFromString(@(_sapp.desc.apple.view_controller_class)) : [UIViewController class];
+    _sapp.ios.view_ctrl = [[view_ctrl_class alloc] init];
     _sapp.ios.view_ctrl.modalPresentationStyle = UIModalPresentationFullScreen;
     _sapp.ios.view_ctrl.view = _sapp.ios.view;
     _sapp.ios.window.rootViewController = _sapp.ios.view_ctrl;
@@ -7064,7 +7072,8 @@
     _sapp_init_state(desc);
     static int argc = 1;
