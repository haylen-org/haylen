+// Whether the scene of the window locks the pointer, which the view keeps from the notifications of UIKit and the handlers of GameController read on their own queue.
+static SDL_AtomicInt pointer_locked;
+
+void UIKit_SetPointerLocked(bool locked)
+{
+    SDL_SetAtomicInt(&pointer_locked, locked ? 1 : 0);
+}
+
+bool UIKit_IsPointerLocked(void)
+{
+    return SDL_GetAtomicInt(&pointer_locked) != 0;
+}
+
+// UIKit reports the buttons and the scrolls of a pointer that the scene does not lock, from any source, such as a mouse, a trackpad, Voice Control, Switch Control, remote control and UI tests, while GameController reads only the mice of the hardware. So GameController reports them only while the scene locks the pointer, when UIKit reports none, and on tvOS, which has no pointer of UIKit.
+static bool IsGCMouseReporting(void)
+{
+#ifdef SDL_PLATFORM_TVOS
+    return true;
+#else
+    return UIKit_IsPointerLocked();
+#endif
+}
