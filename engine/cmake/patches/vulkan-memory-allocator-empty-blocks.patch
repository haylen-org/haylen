+void VmaBlockVector::FreeEmptyBlocks()
+{
+    for (;;)
+    {
+        VmaDeviceMemoryBlock* pBlockToDelete = VMA_NULL;
+        {
+            VmaMutexLockWrite lock(m_Mutex, m_hAllocator->m_UseMutex);
+            for (size_t index = m_Blocks.size(); index-- > 0 && m_Blocks.size() > m_MinBlockCount; )
+            {
+                if (m_Blocks[index]->m_pMetadata->IsEmpty())
+                {
+                    pBlockToDelete = m_Blocks[index];
+                    VmaVectorRemove(m_Blocks, index);
+                    break;
+                }
+            }
+        }
 
+        // Destruction of a free block happens outside of the mutex lock, as in Free.
+        if (pBlockToDelete == VMA_NULL)
+            return;
+        pBlockToDelete->Destroy(m_hAllocator);
+        vma_delete(m_hAllocator, pBlockToDelete);
+    }
+}
