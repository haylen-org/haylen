+        if ((_sapp.android.surface == EGL_NO_SURFACE) && (_sapp.android.context != EGL_NO_CONTEXT)) {
+            eglMakeCurrent(_sapp.android.display, EGL_NO_SURFACE, EGL_NO_SURFACE, _sapp.android.context);
