Reports the scroll of precise devices, such as trackpads, in the points they move with scroll_precise set, where sokol_app scaled them down to a tenth on macOS and to a hundredth on the web, and the scroll of wheels in steps of the wheel on every platform, where the web counted each of the three lines that browsers report for a step as more than one step. On macOS it also reports the phase of the gesture in scroll_phase, from the phase and the momentum phase of the event, and sends the scrolls that only change the phase, when the fingers touch or leave the trackpad, which sokol_app dropped for having no movement.

--- a/sokol_app.h
+++ b/sokol_app.h
@@ -1660,6 +1660,21 @@
 };
 
 /*
+    The phase of the gesture that a scroll belongs to, for devices that report
+    one, such as the trackpads and the mouse of macOS. The fingers touch the
+    device, move, and leave it, and the momentum that the system adds after
+    they leave arrives in its own phase. Wheels report no phase.
+*/
+typedef enum sapp_scroll_phase {
+    SAPP_SCROLLPHASE_NONE,
+    SAPP_SCROLLPHASE_BEGAN,
+    SAPP_SCROLLPHASE_CHANGED,
+    SAPP_SCROLLPHASE_ENDED,
+    SAPP_SCROLLPHASE_MOMENTUM,
+    _SAPP_SCROLLPHASE_FORCE_U32 = 0x7FFFFFFF,
+} sapp_scroll_phase;
+
+/*
     sapp_event
 
     This is an all-in-one event struct passed to the event handler
@@ -1682,6 +1697,8 @@
     float mouse_dy;                     // relative vertical mouse movement since last frame, always valid
     float scroll_x;                     // horizontal mouse wheel scroll distance, valid in MOUSE_SCROLL events
     float scroll_y;                     // vertical mouse wheel scroll distance, valid in MOUSE_SCROLL events
+    bool scroll_precise;                // true when scroll_x and scroll_y are points of a precise device such as a trackpad, false when they are steps of a wheel
+    sapp_scroll_phase scroll_phase;     // phase of the gesture of a precise device, valid in MOUSE_SCROLL events
     int num_touches;                    // number of valid items in the touches[] array
     sapp_touchpoint touches[SAPP_MAX_TOUCHPOINTS];  // current touch points, valid in TOUCHES_BEGIN, TOUCHES_MOVED, TOUCHES_ENDED
     int window_width;                   // current window- and framebuffer sizes in pixels, always valid
@@ -6823,15 +6840,24 @@
     if (_sapp_events_enabled()) {
         float dx = (float) event.scrollingDeltaX;
         float dy = (float) event.scrollingDeltaY;
-        if (event.hasPreciseScrollingDeltas) {
-            dx *= 0.1;
-            dy *= 0.1;
+        sapp_scroll_phase phase = SAPP_SCROLLPHASE_NONE;
+        if (event.momentumPhase != NSEventPhaseNone) {
+            phase = SAPP_SCROLLPHASE_MOMENTUM;
+        } else if (event.phase & (NSEventPhaseBegan | NSEventPhaseMayBegin)) {
+            phase = SAPP_SCROLLPHASE_BEGAN;
+        } else if (event.phase & NSEventPhaseChanged) {
+            phase = SAPP_SCROLLPHASE_CHANGED;
+        } else if (event.phase & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+            phase = SAPP_SCROLLPHASE_ENDED;
         }
-        if ((_sapp_absf(dx) > 0.0f) || (_sapp_absf(dy) > 0.0f)) {
+        /* fingers that touch or leave the trackpad change the phase without moving */
+        if ((_sapp_absf(dx) > 0.0f) || (_sapp_absf(dy) > 0.0f) || (phase == SAPP_SCROLLPHASE_BEGAN) || (phase == SAPP_SCROLLPHASE_ENDED)) {
             _sapp_init_event(SAPP_EVENTTYPE_MOUSE_SCROLL);
             _sapp.event.modifiers = _sapp_macos_mods(event);
             _sapp.event.scroll_x = dx;
             _sapp.event.scroll_y = dy;
+            _sapp.event.scroll_precise = event.hasPreciseScrollingDeltas;
+            _sapp.event.scroll_phase = phase;
             _sapp_call_event(&_sapp.event);
         }
     }
