-- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+// The keys of a hardware keyboard reach the app through GameController, except the Escape key of tvOS, which makes the Menu press of the remote.
+- (BOOL)isKeyboardPress:(UIPress *)press
 {
-    if (!SDL_HasKeyboard()) {
-        for (UIPress *press in presses) {
-            SDL_Scancode scancode = [self scancodeFromPress:press];
-            SDL_SendKeyboardKey(UIKit_GetEventTimestamp([event timestamp]), SDL_GLOBAL_KEYBOARD_ID, 0, scancode, true);
+#ifdef SDL_PLATFORM_TVOS
+    return press.key != nil && press.type != UIPressTypeMenu;
+#else
+    return press.key != nil;
+#endif
+}
+
+// Sends the presses that are no keys of a keyboard as keys, and returns the ones whose key the app dropped through its event filter, which go on to UIKit, such as the Menu press of the remote that leaves the app.
+- (NSSet<UIPress *> *)sendPresses:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event down:(bool)down
+{
+    NSMutableSet<UIPress *> *dropped = [NSMutableSet set];
+    for (UIPress *press in presses) {
+        if ([self isKeyboardPress:press]) {
+            continue;
         }
+        SDL_Scancode scancode = [self scancodeFromPress:press];
+        if (!SDL_SendKeyboardKey(UIKit_GetEventTimestamp([event timestamp]), SDL_GLOBAL_KEYBOARD_ID, 0, scancode, down)) {
+            [dropped addObject:press];
+        }
     }
+    return dropped;
+}
+
+- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    NSSet<UIPress *> *dropped = [self sendPresses:presses withEvent:event down:true];
     if (SDL_TextInputActive(sdlwindow)) {
         [super pressesBegan:presses withEvent:event];
+    } else if (dropped.count > 0) {
+        [super pressesBegan:dropped withEvent:event];
     }
 }
 
