Paces the display link of the main callbacks of iOS, iPadOS, tvOS and visionOS at the rate of SDL_HINT_MAIN_CALLBACK_RATE, as the main callbacks of the other platforms follow it, so an app that aims for fewer frames per second than the display shows lets the display slow down. Without the hint the display link keeps running at the highest rate of the display.

--- a/src/main/ios/SDL_sysmain_callbacks.m
+++ b/src/main/ios/SDL_sysmain_callbacks.m
@@ -37,6 +37,23 @@
 
 static SDLIosMainCallbacksDisplayLink *globalDisplayLink;
 
+static void SDLCALL MainCallbackRateHintChanged(void *userdata, const char *name, const char *oldValue, const char *newValue)
+{
+    SDLIosMainCallbacksDisplayLink *link = (__bridge SDLIosMainCallbacksDisplayLink *)userdata;
+    if (@available(iOS 15.0, tvOS 15.0, *)) {
+        const float callback_rate = newValue ? (float)SDL_atof(newValue) : 0.0f;
+        const SDL_DisplayMode *mode = SDL_GetDesktopDisplayMode(SDL_GetPrimaryDisplay());
+        if (callback_rate > 0.0f) {
+            link.displayLink.preferredFrameRateRange = CAFrameRateRangeMake(callback_rate, callback_rate, callback_rate);
+        } else if (mode && mode->refresh_rate > 60.0f) {
+            int frame_rate = (int)mode->refresh_rate;
+            link.displayLink.preferredFrameRateRange = CAFrameRateRangeMake((frame_rate * 2) / 3, frame_rate, frame_rate);
+        } else {
+            link.displayLink.preferredFrameRateRange = CAFrameRateRangeDefault;
+        }
+    }
+}
+
 @implementation SDLIosMainCallbacksDisplayLink
 
