# Imports a Haylen SDK built for `@HAYLEN_PLATFORM@` with the GPU devices of `@HAYLEN_GRAPHICS_APIS@`, and defines `haylen::engine`, `haylen::runtime`, `haylen::player`, `haylen::native` and `haylen_add_app`.

get_filename_component(_haylen_prefix "${CMAKE_CURRENT_LIST_DIR}/@HAYLEN_SDK_PREFIX_FROM_CONFIG@" ABSOLUTE)

set(HAYLEN_PLATFORM "@HAYLEN_PLATFORM@")
set(HAYLEN_GRAPHICS_APIS "@HAYLEN_GRAPHICS_APIS@")
set(HAYLEN_DESKTOP @HAYLEN_DESKTOP@)
set(HAYLEN_PORT_PLATFORM "@HAYLEN_PORT_PLATFORM@")
set(HAYLEN_PORT_CAPABILITIES "@HAYLEN_PORT_CAPABILITIES@")
set(HAYLEN_PORT_APP_FUNCTION "@HAYLEN_PORT_APP_FUNCTION@")
set(HAYLEN_ENGINE_DIR "${_haylen_prefix}/@HAYLEN_SDK_SHARE_DIR@")
set(HAYLEN_CMAKE_DIR "${HAYLEN_ENGINE_DIR}/cmake")
set(HAYLEN_VARN_DATAVIEW_SCRIPT "${HAYLEN_ENGINE_DIR}/platform/web/varn-dataview.js")

include(CMakeFindDependencyMacro)
@HAYLEN_SDK_DEPENDENCIES@

if(NOT TARGET haylen::engine)
  add_library(haylen::engine STATIC IMPORTED)
  set_target_properties(haylen::engine PROPERTIES
    IMPORTED_LOCATION "${_haylen_prefix}/@CMAKE_INSTALL_LIBDIR@/@HAYLEN_SDK_ENGINE_FILE@"
    INTERFACE_INCLUDE_DIRECTORIES "${_haylen_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_COMPILE_DEFINITIONS "@HAYLEN_SDK_DEFINITIONS@;IMGUI_USER_CONFIG=\"${_haylen_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/haylen/ui/ImGuiConfig.hpp\""
    INTERFACE_COMPILE_OPTIONS "@HAYLEN_SDK_COMPILE_OPTIONS@"
    INTERFACE_LINK_OPTIONS "@HAYLEN_SDK_LINK_OPTIONS@"
    INTERFACE_LINK_LIBRARIES "@HAYLEN_SDK_EXTERNALS@"
  )

  add_library(haylen::runtime STATIC IMPORTED)
  set_target_properties(haylen::runtime PROPERTIES
    IMPORTED_LOCATION "${_haylen_prefix}/@CMAKE_INSTALL_LIBDIR@/@HAYLEN_SDK_RUNTIME_FILE@"
    INTERFACE_LINK_LIBRARIES haylen::engine
    INTERFACE_COMPILE_OPTIONS "@HAYLEN_SDK_RUNTIME_COMPILE_OPTIONS@"
    INTERFACE_LINK_OPTIONS "@HAYLEN_SDK_RUNTIME_LINK_OPTIONS@"
  )

  # The Lua player is one object, which defines the app of a Lua app, so a C++ app that defines its own never links it.
  add_library(haylen::player OBJECT IMPORTED)
  set_target_properties(haylen::player PROPERTIES
    IMPORTED_OBJECTS "${_haylen_prefix}/@CMAKE_INSTALL_LIBDIR@/@HAYLEN_SDK_PLAYER_FILE@"
    INTERFACE_LINK_LIBRARIES haylen::engine
  )

  # Native libraries compile against the native API and nlohmann/json of the SDK without linking the engine.
  add_library(haylen::native INTERFACE IMPORTED)
  set_target_properties(haylen::native PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_haylen_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")

  include("${HAYLEN_CMAKE_DIR}/haylen-app.cmake")
  @HAYLEN_SDK_PORT_MODULE@
  # The runtime of a port links the libraries of its platform itself.
  if(NOT HAYLEN_PORT_PLATFORM)
    haylen_link_runtime_platform(haylen::runtime INTERFACE)
  endif()
endif()

unset(_haylen_prefix)
