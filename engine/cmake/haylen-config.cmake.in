# Imports a Haylen SDK built for `@HAYLEN_PLATFORM@` with the `@HAYLEN_BACKEND@` backend, and defines `haylen::engine`, `haylen::runtime` and `haylen_add_app`.

get_filename_component(_haylen_prefix "${CMAKE_CURRENT_LIST_DIR}/@HAYLEN_SDK_PREFIX_FROM_CONFIG@" ABSOLUTE)

set(HAYLEN_PLATFORM "@HAYLEN_PLATFORM@")
set(HAYLEN_BACKEND "@HAYLEN_BACKEND@")
set(HAYLEN_DESKTOP @HAYLEN_DESKTOP@)
set(HAYLEN_ENGINE_DIR "${_haylen_prefix}/@HAYLEN_SDK_SHARE_DIR@")
set(HAYLEN_CMAKE_DIR "${HAYLEN_ENGINE_DIR}/cmake")

include(CMakeFindDependencyMacro)
@HAYLEN_SDK_DEPENDENCIES@

if(NOT TARGET haylen::engine)
  add_library(haylen::engine STATIC IMPORTED)
  set_target_properties(haylen::engine PROPERTIES
    IMPORTED_LOCATION "${_haylen_prefix}/@CMAKE_INSTALL_LIBDIR@/@HAYLEN_SDK_ENGINE_FILE@"
    INTERFACE_INCLUDE_DIRECTORIES "${_haylen_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_COMPILE_DEFINITIONS "@HAYLEN_SDK_DEFINITIONS@;IMGUI_USER_CONFIG=\"${_haylen_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/haylen/ui/ImGuiConfig.hpp\""
    INTERFACE_COMPILE_OPTIONS "@HAYLEN_SDK_COMPILE_OPTIONS@"
    INTERFACE_LINK_OPTIONS "@HAYLEN_SDK_LINK_OPTIONS@"
    INTERFACE_LINK_LIBRARIES "@HAYLEN_SDK_EXTERNALS@"
  )

  add_library(haylen::runtime STATIC IMPORTED)
  set_target_properties(haylen::runtime PROPERTIES
    IMPORTED_LOCATION "${_haylen_prefix}/@CMAKE_INSTALL_LIBDIR@/@HAYLEN_SDK_RUNTIME_FILE@"
    INTERFACE_LINK_LIBRARIES haylen::engine
  )

  include("${HAYLEN_CMAKE_DIR}/haylen-app.cmake")
  haylen_link_runtime_platform(haylen::runtime INTERFACE)
endif()

unset(_haylen_prefix)
