# The GPU devices of the engine: the static library `haylen-gpu` with `gpu::DeviceFactory` and the device of every graphics API of `HAYLEN_GRAPHICS_APIS`. Each device folder under `src/gpu` holds a `device.cmake`, which adds its sources and libraries to `haylen-gpu`, defines `HAYLEN_GPU_<API>` on it, such as `HAYLEN_GPU_VULKAN`, and adds what the GPU tests need to `HAYLEN_GPU_TEST_SOURCES` and `HAYLEN_GPU_TEST_LIBRARIES`.

# The graphics APIs of each platform in the order it prefers them, the names of `gpu::Device::kApiNames`.
if(APPLE)
  set(haylen_platform_graphics_apis metal)
elseif(WIN32)
  set(haylen_platform_graphics_apis direct3D12 direct3D11 vulkan openGl)
elseif(ANDROID)
  set(haylen_platform_graphics_apis vulkan openGlEs)
elseif(EMSCRIPTEN)
  set(haylen_platform_graphics_apis webGpu webGl2)
else()
  set(haylen_platform_graphics_apis vulkan openGl)
endif()

set(HAYLEN_GRAPHICS_APIS "${haylen_platform_graphics_apis}" CACHE STRING "Graphics APIs whose devices the build compiles, every API of the platform by default: metal, direct3D12, direct3D11, vulkan, openGl, openGlEs, webGpu and webGl2.")
if(NOT HAYLEN_GRAPHICS_APIS)
  message(FATAL_ERROR "The option \"HAYLEN_GRAPHICS_APIS\" names no graphics API. Name at least one of \"${haylen_platform_graphics_apis}\".")
endif()
foreach(api IN LISTS HAYLEN_GRAPHICS_APIS)
  if(NOT api IN_LIST haylen_platform_graphics_apis)
    string(REPLACE ";" "\", \"" known "${haylen_platform_graphics_apis}")
    message(FATAL_ERROR "The graphics API \"${api}\" of \"HAYLEN_GRAPHICS_APIS\" does not run on \"${HAYLEN_PLATFORM}\", whose APIs are \"${known}\".")
  endif()
endforeach()

# The shader languages that the device of each API runs, which the shader packages of the engine carry. Metal carries its three kinds, since one slice of iOS runs on devices and Mac Catalyst and another on the simulator.
set(haylen_shader_languages_metal msl-macos msl-ios msl-ios-simulator)
set(haylen_shader_languages_direct3D12 hlsl5)
set(haylen_shader_languages_direct3D11 hlsl5)
set(haylen_shader_languages_vulkan spirv)
set(haylen_shader_languages_openGl glsl430)
set(haylen_shader_languages_openGlEs glsl300es)
set(haylen_shader_languages_webGl2 glsl300es)
set(haylen_shader_languages_webGpu wgsl)

# The folder of the device of each API, where OpenGL, OpenGL ES and WebGL2 share one device.
set(haylen_device_folder_metal metal)
set(haylen_device_folder_direct3D12 d3d12)
set(haylen_device_folder_direct3D11 d3d11)
set(haylen_device_folder_vulkan vulkan)
set(haylen_device_folder_openGl opengl)
set(haylen_device_folder_openGlEs opengl)
set(haylen_device_folder_webGl2 opengl)
set(haylen_device_folder_webGpu webgpu)

# The shader packages of the engine carry them next to the language of the backend, for every API of the list whose device folder the tree holds, since an API without its device runs no shader.
foreach(api IN LISTS HAYLEN_GRAPHICS_APIS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../src/gpu/${haylen_device_folder_${api}}/device.cmake")
    list(APPEND HAYLEN_SHADER_LANGUAGES ${haylen_shader_languages_${api}})
  endif()
endforeach()
list(REMOVE_DUPLICATES HAYLEN_SHADER_LANGUAGES)

function(haylen_add_gpu_library)
  add_library(haylen-gpu STATIC "${HAYLEN_ENGINE_DIR}/src/gpu/DeviceFactory.cpp")
  add_library(haylen::gpu ALIAS haylen-gpu)
  target_include_directories(haylen-gpu PRIVATE "${HAYLEN_ENGINE_DIR}/src")
  target_link_libraries(haylen-gpu PUBLIC haylen-engine)
  haylen_enable_warnings(haylen-gpu)
  haylen_enable_coverage(haylen-gpu)

  set(HAYLEN_GPU_TEST_SOURCES "")
  set(HAYLEN_GPU_TEST_LIBRARIES "")
  set(compiled "")
  # An API whose device folder the tree does not hold compiles no device, which the status line below shows.
  foreach(api IN LISTS HAYLEN_GRAPHICS_APIS)
    set(device "${HAYLEN_ENGINE_DIR}/src/gpu/${haylen_device_folder_${api}}/device.cmake")
    if(EXISTS "${device}")
      include("${device}")
      list(APPEND compiled "${api}")
    endif()
  endforeach()
  set(HAYLEN_GPU_TEST_SOURCES "${HAYLEN_GPU_TEST_SOURCES}" PARENT_SCOPE)
  set(HAYLEN_GPU_TEST_LIBRARIES "${HAYLEN_GPU_TEST_LIBRARIES}" PARENT_SCOPE)
  set(HAYLEN_GPU_COMPILED_APIS "${compiled}" PARENT_SCOPE)
  message(STATUS "Haylen GPU devices: \"${compiled}\" of \"${HAYLEN_GRAPHICS_APIS}\"")
endfunction()
