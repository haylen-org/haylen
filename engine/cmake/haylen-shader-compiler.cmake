# Provides the Haylen shader compiler `haylen-shaderc`, pinned in `haylen-shader-compiler.json` to a release and the commit of that release. A machine whose system and processor the release ships a binary for downloads it and checks its SHA-256, and any other machine downloads the source of the commit, checks it the same way and builds the compiler there, so every machine that runs CMake gets a compiler. Each version lives in a folder of its own under the cache folder, so a new pin brings its own compiler and every build tree shares one.
# The engine includes this file when `HAYLEN_SHADERC` names no compiler, and `haylen.py` runs it as a script, `cmake -D HAYLEN_SHADERC_CACHE=<folder> -D HAYLEN_SHADERC_RESULT=<file> -P haylen-shader-compiler.cmake`, which writes the path of the compiler into the result file.

# The system and processor of the machine as the pins name them, such as `macos-arm64` or `windows-x64`.
function(haylen_shader_compiler_host output)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(system "macos")
  else()
    string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" system)
  endif()
  # The processor comes from the system, since a script run knows no `CMAKE_HOST_SYSTEM_PROCESSOR`.
  cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
  string(TOLOWER "${processor}" processor)
  if(processor MATCHES "^(arm64|aarch64)$")
    set(processor "arm64")
  elseif(processor MATCHES "^(x86_64|amd64)$")
    set(processor "x64")
  endif()
  set(${output} "${system}-${processor}" PARENT_SCOPE)
endfunction()

# Sets `output` to the path of the compiler that the pins at `pins` name, which it downloads or builds into `cache` the first time.
function(haylen_shader_compiler output pins cache)
  file(READ "${pins}" document)
  string(JSON version GET "${document}" version)
  string(JSON commit GET "${document}" commit)
  string(SUBSTRING "${commit}" 0 7 short)
  if(CMAKE_HOST_WIN32)
    set(executable "haylen-shaderc.exe")
  else()
    set(executable "haylen-shaderc")
  endif()
  haylen_shader_compiler_host(host)
  string(JSON binary ERROR_VARIABLE missing GET "${document}" binaries "${host}")
  if(missing)
    set(folder "${cache}/haylen-shaderc-${short}")
  else()
    set(folder "${cache}/haylen-shaderc-${version}")
  endif()
  set(${output} "${folder}/${executable}" PARENT_SCOPE)
  if(EXISTS "${folder}/${executable}")
    return()
  endif()

  # Builds that configure at the same time wait for the first one, which moves the finished compiler into place.
  file(MAKE_DIRECTORY "${cache}")
  file(LOCK "${folder}.lock" GUARD FUNCTION)
  if(EXISTS "${folder}/${executable}")
    return()
  endif()
  if(missing)
    message(STATUS "Building the Haylen shader compiler at ${short}, since its release ${version} has no binary for ${host}, which takes a while")
    string(JSON url GET "${document}" source url)
    string(JSON sha256 GET "${document}" source sha256)
    haylen_shader_compiler_build("${url}" "${sha256}" "${folder}" "${executable}")
  else()
    message(STATUS "Downloading the Haylen shader compiler ${version} for ${host}")
    string(JSON url GET "${binary}" url)
    string(JSON sha256 GET "${binary}" sha256)
    haylen_shader_compiler_fetch("${url}" "${sha256}" "${folder}/download" contents)
    file(CHMOD "${contents}/${executable}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    file(RENAME "${contents}/${executable}" "${folder}/${executable}")
  endif()
  file(REMOVE_RECURSE "${folder}/download")
endfunction()

# Builds the compiler from the source at `url` into `folder`. The compiler runs on the machine that builds, so the variables of a cross build stay out of its build, and the build takes half of the processors so the machine stays usable.
function(haylen_shader_compiler_build url sha256 folder executable)
  haylen_shader_compiler_fetch("${url}" "${sha256}" "${folder}/download" contents)
  file(GLOB source LIST_DIRECTORIES true "${contents}/*")
  set(tree "${folder}/download/build")
  set(clean "${CMAKE_COMMAND}" -E env --unset=CMAKE_TOOLCHAIN_FILE --unset=CC --unset=CXX --unset=CFLAGS --unset=CXXFLAGS --unset=LDFLAGS)
  set(options -DCMAKE_BUILD_TYPE=Release -DHAYLEN_SHADERC_BUILD_TESTS=OFF)
  if(CPM_SOURCE_CACHE)
    list(APPEND options "-DCPM_SOURCE_CACHE=${CPM_SOURCE_CACHE}")
  endif()
  cmake_host_system_information(RESULT processors QUERY NUMBER_OF_LOGICAL_CORES)
  math(EXPR jobs "(${processors} + 1) / 2")

  execute_process(COMMAND ${clean} "${CMAKE_COMMAND}" -S "${source}" -B "${tree}" ${options} RESULT_VARIABLE configured)
  if(NOT configured EQUAL 0)
    message(FATAL_ERROR "The Haylen shader compiler could not be configured in \"${tree}\". Its output above names the cause.")
  endif()
  execute_process(COMMAND ${clean} "${CMAKE_COMMAND}" --build "${tree}" --config Release --target haylen-shaderc --parallel ${jobs} RESULT_VARIABLE built)
  file(GLOB_RECURSE made "${tree}/${executable}")
  if(NOT built EQUAL 0 OR NOT made)
    message(FATAL_ERROR "The Haylen shader compiler did not build in \"${tree}\". Its output above names the cause.")
  endif()
  list(GET made 0 made)
  file(RENAME "${made}" "${folder}/${executable}")
endfunction()

# Downloads `url` into `folder`, checks its SHA-256, which deletes a download that differs, and sets `output` to the folder its archive extracts into.
function(haylen_shader_compiler_fetch url sha256 folder output)
  get_filename_component(name "${url}" NAME)
  file(DOWNLOAD "${url}" "${folder}/${name}" TLS_VERIFY ON STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    list(GET status 1 reason)
    file(REMOVE_RECURSE "${folder}")
    message(FATAL_ERROR "The download of \"${url}\" failed: ${reason}. Check the connection, or name a build of the compiler with \"HAYLEN_SHADERC\".")
  endif()
  file(SHA256 "${folder}/${name}" digest)
  if(NOT digest STREQUAL sha256)
    file(REMOVE_RECURSE "${folder}")
    message(FATAL_ERROR "The download of \"${url}\" does not match its pinned SHA-256 \"${sha256}\", so it was deleted. Try again, and if it still differs, the file on the server changed.")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${folder}/${name}" DESTINATION "${folder}/contents")
  set(${output} "${folder}/contents" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT HAYLEN_SHADERC_CACHE OR NOT HAYLEN_SHADERC_RESULT)
    message(FATAL_ERROR "Name the folder that keeps the compiler with \"-D HAYLEN_SHADERC_CACHE=<folder>\" and the file that receives its path with \"-D HAYLEN_SHADERC_RESULT=<file>\".")
  endif()
  if(NOT HAYLEN_SHADERC_PINS)
    set(HAYLEN_SHADERC_PINS "${CMAKE_CURRENT_LIST_DIR}/haylen-shader-compiler.json")
  endif()
  haylen_shader_compiler(compiler "${HAYLEN_SHADERC_PINS}" "${HAYLEN_SHADERC_CACHE}")
  file(WRITE "${HAYLEN_SHADERC_RESULT}" "${compiler}")
endif()
