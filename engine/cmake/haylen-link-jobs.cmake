# A link of a large program takes several times the memory of a compile, and the sanitizers, link-time optimization and the full debug information take more again, so Ninja runs the links of the build in a pool of their own whose size the memory of this machine bounds, while the compiles keep every job of the build.
set(HAYLEN_LINK_JOBS "" CACHE STRING "The links that Ninja runs at once, or empty for as many as the memory of this machine holds for the kind of build.")

# The memory in mebibytes that one link of the largest programs takes in each kind of build: the peak that `docs/tools/build.md` measures with a third more for the compiles that run beside it, rounded up to a whole gibibyte.
if(HAYLEN_DEBUG_INFO STREQUAL "FULL" AND NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  set(haylen_full_debug_info ON)
else()
  set(haylen_full_debug_info OFF)
endif()
if(HAYLEN_SANITIZERS STREQUAL "ADDRESS" OR HAYLEN_BUILD_FUZZERS)
  set(haylen_link_memory 17408)
  if(haylen_full_debug_info)
    set(haylen_link_memory 25600)
  endif()
elseif(HAYLEN_SANITIZERS STREQUAL "THREAD")
  set(haylen_link_memory 11264)
elseif(HAYLEN_LINK_TIME_OPTIMIZATION AND CMAKE_BUILD_TYPE STREQUAL "Release")
  set(haylen_link_memory 6144)
else()
  set(haylen_link_memory 5120)
  if(haylen_full_debug_info)
    set(haylen_link_memory 8192)
  endif()
endif()

if(HAYLEN_LINK_JOBS STREQUAL "")
  cmake_host_system_information(RESULT haylen_memory QUERY TOTAL_PHYSICAL_MEMORY)
  math(EXPR haylen_link_jobs "${haylen_memory} / ${haylen_link_memory}")
  if(haylen_link_jobs LESS 1)
    set(haylen_link_jobs 1)
  endif()
elseif(HAYLEN_LINK_JOBS MATCHES "^[1-9][0-9]*$")
  set(haylen_link_jobs ${HAYLEN_LINK_JOBS})
else()
  message(FATAL_ERROR "The option \"HAYLEN_LINK_JOBS\" is a whole number of links of at least 1, or empty, not \"${HAYLEN_LINK_JOBS}\".")
endif()

set_property(GLOBAL APPEND PROPERTY JOB_POOLS haylen-link=${haylen_link_jobs})
set(CMAKE_JOB_POOL_LINK haylen-link)
