<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A foreground service of the type that plays media, which Android 14 and later grant with the permission of the type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!-- Keeps the app in the foreground with its media notification while what it plays shows as playing, so its sound plays on in the background. -->
        <service
            android:name="dev.haylen.HaylenPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
