<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access, the network events and the rumble of gamepads need these normal permissions, which Android grants at the install without asking. The development server reaches the app through `adb reverse` and the loopback address, which needs no permission, and an app that reaches the devices of the local network takes a plugin that declares and asks for `ACCESS_LOCAL_NETWORK`. An app that does not use a feature names its permission in `platforms.android.manifest.removedPermissions` of `haylen.json`, and the feature then logs once what is missing and does nothing or fails its calls with the code `unsupported`. -->
{{PERMISSIONS}}

    <!-- Phones, tablets and TVs run the app, so it needs neither a touchscreen nor a screen orientation, and it takes gamepads and TV remotes. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Back reaches `HaylenActivity` through its `OnBackPressedCallback`, which Android 13 and later call through the back callbacks of the window that `enableOnBackInvokedCallback` turns on, so the system plays its predictive back animation when back leaves the app. -->
    <application
{{APPLICATION_ATTRIBUTES}}>
        <!-- Single top keeps one activity, which GameActivity needs, without destroying the screens of plugins that show over the app, such as a purchase, when the launcher icon brings the app back. Links and notifications go through `dev.haylen.HaylenLinkActivity`, which the `haylen-links` library of the plugins that receive them declares. The activity takes every change of the configuration itself, such as a new language or font size, so the app keeps running through it instead of starting again. -->
        <activity
            android:name="dev.haylen.HaylenActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|density|uiMode|colorMode|locale|layoutDirection|fontScale|fontWeightAdjustment|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="{{ORIENTATION}}">
            <meta-data
                android:name="android.app.lib_name"
                android:value="{{LIBRARY}}" />
            <meta-data
                android:name="dev.haylen.statusBar"
                android:value="{{STATUS_BAR}}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
